# Copy to .env and fill in the values.

# Shared secret expected in the X-API-Key header. Required, no default.
API_KEY=

# Host ports published by Compose. Change them if 8000 or 5432 are taken.
API_PORT=8000
POSTGRES_PORT=5432

# SQLAlchemy URL for PostgreSQL, using the psycopg 3 driver. Used by the API when it
# runs outside Docker (uv run ...) and by the test suite, which swaps the database
# name for podcasts_test. The Compose `api` service sets its own URL instead.
# Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgresql+psycopg://podcasts:podcasts@localhost:5432/podcasts

# --- Ingestion (all optional) ---

# Where POST /ingest/* reads podcasts from: "itunes" (live API) or "fixtures"
# (replays the stored responses under tests/fixtures/itunes, no network needed).
INGEST_SOURCE=itunes

# Timeout for each iTunes request, in seconds. Requests are retried up to 3 times
# on timeouts, connection errors and 5xx responses.
ITUNES_TIMEOUT_SECONDS=10

# Artwork downloads for colour palettes: concurrent threads and per-image timeout.
ARTWORK_WORKERS=8
ARTWORK_TIMEOUT_SECONDS=5
