# Copy to .env and fill in the values.

# Shared secret expected in the X-API-Key header. Required, no default.
API_KEY=

# Host port published by the Compose `db` service. Change it if 5432 is taken,
# and use the same port in DATABASE_URL.
POSTGRES_PORT=5432

# SQLAlchemy URL for PostgreSQL, using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://podcasts:podcasts@localhost:5432/podcasts
